<Page
    x:Class="Calculator.MortgageCalculator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
		<StackPanel
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Background="DarkSeaGreen">
			
			<TextBlock
				Text="Mortgage Calculator"
				FontSize="30"
				FontWeight="Bold"
				Foreground="White"
				HorizontalAlignment="Center"
				Margin="20,20,20,20" />

			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Principal borrowed ($):"
						   FontSize="20"
						   Width="220"
						   Margin="10"
						   VerticalAlignment="Center" />

				<TextBox x:Name="principalInput"
							Margin="10"
							Width="180"
						    PlaceholderText="Enter loan amount" />
			</StackPanel>

			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Years:"
						   FontSize="20"
						   Width="220"
						   Margin="10"
						   VerticalAlignment="Center" />	

				<TextBox x:Name="yearsInput"
							Margin="10"
							Width="180"
						    PlaceholderText="Enter loan years (e.g. 30)" />
			</StackPanel>

			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Months:"
						   FontSize="20"
						   Width="220"
						   Margin="10"
						   VerticalAlignment="Center" />

				<TextBox x:Name="monthsInput"
							Margin="10"
							Width="180"
						    PlaceholderText="Extra months (if any)"/>
			</StackPanel>

			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Annual Interest Rate (%):"
						   FontSize="20"
						   Width="220"
						   Margin="10"
						   VerticalAlignment="Center" />

				<TextBox x:Name="annualInterestInput"
							Margin="10"
							Width="180"
						    PlaceholderText="Enter annual rate (e.g. 4)"/>	
			</StackPanel>

			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Monthly Interest Rate (%):"
						   FontSize="20"
						   Width="220"
						   Margin="10"
						   VerticalAlignment="Center" />

				<TextBox x:Name="monthlyInterestOutput"
							Margin="10"
							Width="180"
						    IsReadOnly="True"/>
			</StackPanel>

			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Monthly Repayment:"
						   FontSize="20"
						   Width="220"
						   Margin="10"
						   VerticalAlignment="Center" />

				<TextBox x:Name="monthlyRepaymentOutput"
							Margin="10"
							Width="180"
							IsReadOnly="True"/>
			</StackPanel>


			<StackPanel Orientation="Horizontal"
						HorizontalAlignment="Right">
				
				<Button x:Name="calculateButton"
						Content="Calculate"
						FontSize="20"
						FontWeight="Bold"
						Width="120"
						Height="40"
						Margin="5"
						HorizontalAlignment="Center"
						Background="DarkCyan"
						Click="calculateButton_Click"/>

				<Button x:Name="exitButton"
						Content="Exit"
						FontSize="20"
						FontWeight="Bold"
						Width="120"
						Height="40"
						Margin="5"
						HorizontalAlignment="Center"
						Background="DarkCyan"
						Click="exitButton_Click"/>

			</StackPanel>

		</StackPanel>
	</Grid>
</Page>
