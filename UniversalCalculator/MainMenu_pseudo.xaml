<Page x:Class="Calculator.MainMenu_pseudo"
		  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		  Loaded="pageLoaded"
		  Background="{ThemeResource SystemControlAcrylicWindowBrush}">

    <Grid>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
			Background="DarkSeaGreen"
            Width="300">

            <TextBlock
                Text="Universal Calculator"
                FontSize="30				"
				FontWeight="Bold"
				Foreground="White"
                HorizontalAlignment="Center"
                Margin="0,20,0,20" />

			<Image
				Source="/Images/abacus.jpg"
				Height="100"
				Stretch="Uniform"
				HorizontalAlignment="Right"
				Margin="0,0,20,15" />	

			<Button
                Content="Math Calculator"
				Background="DarkCyan"
				Foreground="White"
				BorderThickness="2"
                Margin="5"
                Height="45" />

            <Button
                Content="Mortgage Calculator"
				Background="DarkCyan"
				Foreground="White"
				BorderThickness="2"
                Margin="5"
                Height="45" />

            <Button
                Content="Currency Calculator"
				Background="DarkCyan"
				Foreground="White"
				BorderThickness="2"
                Margin="5"
                Height="45" />

            <Button
                Content="Exit"
				Background="DarkCyan"
				Foreground="White"
				BorderThickness="2"
                Margin="5"
                Height="45" />

        </StackPanel>
    </Grid>
</Page>